{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run C++ in kitty",
      "type": "shell",
      "command": "kitty",
      "args": [
        "--hold",
        "bash",
        "-c",
        "g++ \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\""
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    }
  ]
}